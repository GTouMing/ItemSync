<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ItemSync" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/itemsync_paper</item>
        <item name="android:colorPrimary">@color/itemsync_copper</item>
        <item name="android:colorPrimaryDark">@color/itemsync_paper</item>
        <item name="android:colorAccent">@color/itemsync_copper</item>
        <item name="android:colorControlActivated">@color/itemsync_copper</item>
        <item name="android:colorControlHighlight">@color/itemsync_copper_soft</item>
        <item name="android:colorControlNormal">@color/itemsync_muted</item>
        <item name="android:statusBarColor">@color/itemsync_paper</item>
        <item name="android:navigationBarColor">@color/itemsync_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/itemsync_ink</item>
        <item name="android:textColorSecondary">@color/itemsync_muted</item>
        <item name="android:textColorHint">@color/itemsync_muted</item>
        <item name="android:alertDialogTheme">@style/Theme.ItemSync.Dialog</item>
        <item name="android:buttonStyle">@style/Widget.ItemSync.Button</item>
        <item name="android:editTextStyle">@style/Widget.ItemSync.EditText</item>
    </style>

    <style name="Theme.ItemSync.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/itemsync_copper</item>
        <item name="android:colorControlActivated">@color/itemsync_copper</item>
        <item name="android:textColorPrimary">@color/itemsync_ink</item>
        <item name="android:textColorSecondary">@color/itemsync_muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/Widget.ItemSync.DialogButton</item>
    </style>

    <style name="Widget.ItemSync.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/itemsync_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.ItemSync.DialogButton"
        parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/itemsync_copper_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.ItemSync.EditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:textColor">@color/itemsync_ink</item>
        <item name="android:textColorHint">@color/itemsync_muted</item>
        <item name="android:backgroundTint">@color/itemsync_copper</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
